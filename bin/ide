#!/usr/bin/env bash
# Open (or re-attach to) an IDE session for a project directory.
#   ide [dir]   project in dir (default: current directory)
#   ide -p      pick from running sessions and ~/src/* (also what plain `ide` does in $HOME)
# Re-attaching keeps whatever config the session started with, so if the atomic-dev config
# has changed since (or the session predates this check), offer to restart it.
set -euo pipefail
if [ -n "${ZELLIJ:-}" ]; then
  echo "Already inside a Zellij session. Detach first (Ctrl-q d)." >&2; exit 1
fi
sessions_dir="${XDG_CACHE_HOME:-$HOME/.cache}/atomic-dev/sessions"
projects_dir="${IDE_PROJECTS:-$HOME/src}"

# Running sessions first (with the folder they were opened in), then projects not yet open
pick_project() {
  local running name dir tilde='~'
  running=$(zellij list-sessions --no-formatting 2>/dev/null | awk '!/EXITED/ { print $1 }') || true
  {
    for name in $running; do
      dir=$(cat "$sessions_dir/$name.dir" 2>/dev/null) || continue
      printf '● %-24s %s\t%s\n' "$name" "${dir/#$HOME/$tilde}" "$dir"
    done
    for dir in "$projects_dir"/*/; do
      [ -d "$dir" ] || continue
      dir=${dir%/}
      grep -qx "$(basename "$dir" | tr -c 'A-Za-z0-9_\n-' '-')" <<<"$running" && continue
      printf '  %-24s %s\t%s\n' "$(basename "$dir")" "${dir/#$HOME/$tilde}" "$dir"
    done
  } | fzf --delimiter '\t' --with-nth 1 --prompt 'project> ' --header '● = running' --height 40% --reverse |
    cut -f2
}

if [ "${1:-}" = -p ] || { [ $# -eq 0 ] && [ "$PWD" = "$HOME" ] && [ -t 0 ]; }; then
  if command -v fzf >/dev/null 2>&1; then
    dir=$(pick_project) || true
    [ -n "$dir" ] || exit 0   # picker cancelled
    set -- "$dir"
  elif [ "${1:-}" = -p ]; then
    echo "ide -p needs fzf" >&2; exit 1
  fi
fi
cd "${1:-.}"
cd "$(pwd -P)"
export IDE_ROOT="$PWD"   # Yazi's project-root plugin stops here
# '-' goes last in the set: GNU tr reads '_-\n' as a range
name=$(basename "$PWD" | tr -c 'A-Za-z0-9_\n-' '-')

# Fingerprint of the repo's config/ and bin/ (this script is symlinked from the repo's bin/)
repo=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")")/.." && pwd -P)
fingerprint=""
if [ -d "$repo/config" ]; then
  fingerprint=$(find "$repo/config" "$repo/bin" -type f -print0 | LC_ALL=C sort -z | xargs -0 cat | cksum)
fi
stamp="$sessions_dir/$name"

new_session() {
  mkdir -p "$sessions_dir"
  printf '%s\n' "$fingerprint" > "$stamp"
  printf '%s\n' "$PWD" > "$stamp.dir"   # for the project picker
  exec zellij --session "$name" --new-session-with-layout ide
}

state=$(zellij list-sessions --no-formatting 2>/dev/null |
  awk -v n="$name" '$1 == n { print (/EXITED/ ? "exited" : "running") }') || true  # fails when no sessions exist
# A quit (exited) session would come back with every pane paused at "press ENTER", so replace it
if [ "$state" = exited ]; then zellij delete-session "$name" >/dev/null 2>&1 || true; fi
if [ "$state" != running ]; then
  new_session
fi

if [ -n "$fingerprint" ] && [ "$(cat "$stamp" 2>/dev/null)" != "$fingerprint" ] && [ -t 0 ]; then
  echo "Session '$name' was started before the IDE config last changed, so it would still use the old setup."
  echo "Restarting closes its panes (Helix auto-saves; anything running in its shells stops)."
  printf '[R]estart with the new config (default) / [a]ttach anyway? '
  read -r answer || answer=""
  case "$answer" in
    a|A) ;;
    *) zellij delete-session --force "$name" >/dev/null 2>&1 || true
       new_session ;;
  esac
fi
exec zellij attach "$name"
