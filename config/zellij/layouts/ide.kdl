layout {
    default_tab_template {
        children
        pane size=1 borderless=true command="ide-hints"
        pane size=1 borderless=true { plugin location="zellij:compact-bar"; }
    }
    tab name="code" focus=true {
        pane split_direction="vertical" {
            pane size="22%" name=" " command="ide-pane" { args "ide-files"; }
            pane name=" " command="ide-pane" focus=true { args "hx"; }
        }
    }
    tab name="git" {
        pane name=" " command="ide-pane" { args "lazygit"; }
    }
    tab name="shell" {
        pane
    }
}
